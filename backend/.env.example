# Copy to backend/.env (git-ignored) and fill in. Real environment variables override this file.

# Session signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_JWT_SECRET=

# Admin account created (or updated) on startup.
SENTINEL_ADMIN_EMAIL=admin@example.com
SENTINEL_ADMIN_PASSWORD=

# Let anyone create an account (true) or only the admin above (false).
SENTINEL_ALLOW_SIGNUP=true

# Session length in minutes.
SENTINEL_SESSION_MINUTES=30

# true = cookie only sent over HTTPS (production). false for a local http:// demo.
SENTINEL_COOKIE_SECURE=false

# Frontend origins allowed to call the API with the session cookie (comma-separated).
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: key for encrypting scan workspaces at rest (32 bytes, url-safe base64). Generate with:
#   python -c "from app.vault import generate_key; print(generate_key())"
SENTINEL_DATA_KEY=

# Fix-watcher: dependency pins with published security fixes (off when unset).
#   osv               ask api.osv.dev (sends package names and versions only, never code)
#   /path/vulns.json  use a downloaded OSV export, fully offline
# SENTINEL_FIXWATCH=osv
